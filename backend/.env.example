# FastAPI Backend Environment Variables
APP_ENV=local
SECRET_KEY=change_me_to_a_random_secret_key_in_production
SESSION_LIFETIME_MINUTES=120

# PostgreSQL Database
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pickwise
DB_USERNAME=pickwise
DB_PASSWORD=pickwise

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Groq LLM API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20

# AI Daily Quotas
AI_DAILY_QUOTA_USER=30
AI_DAILY_QUOTA_GUEST=10
