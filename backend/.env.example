# FastAPI Backend Environment Variables
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
SECRET_KEY=change_me_to_a_random_secret_key_in_production
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL Database (Provide either DATABASE_URL or individual DB_* variables)
# DATABASE_URL=postgresql://user:password@host:5432/pickwise
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pickwise
DB_USERNAME=pickwise
DB_PASSWORD=pickwise

# Redis (Provide either REDIS_URL or individual REDIS_* variables)
# REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Groq LLM API
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=20

# AI Daily Quotas
AI_DAILY_QUOTA_USER=30
AI_DAILY_QUOTA_GUEST=10
